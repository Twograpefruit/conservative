{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conser",
  "version": "0.1.0",
  "identifier": "dev.conser.desktop",
  "build": {
    "frontendDist": "../../gui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Conser",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "url": "about:blank"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["server/**/*", "gui/**/*"],
    "externalBin": ["binaries/node"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
